{
  "datasets": [
    {
      "name": "pipeline_ds",
      "displayName": "Pipeline Layer Counts",
      "queryLines": [
        "SELECT\n",
        "  'Bronze' as layer,\n",
        "  COUNT(*) as record_count\n",
        "FROM\n",
        "  fraud_kafka_project.bronze.bronze_credit_card_transactions\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Silver' as layer,\n",
        "  COUNT(*) as record_count\n",
        "FROM\n",
        "  fraud_kafka_project.silver.silver_credit_card_transactions\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Gold' as layer,\n",
        "  COUNT(*) as record_count\n",
        "FROM\n",
        "  fraud_kafka_project.gold.fraud_dectection"
      ]
    },
    {
      "name": "gold_sql",
      "displayName": "Gold Fraud Data",
      "queryLines": [
        "SELECT\n",
        "  risk_level,\n",
        "  reason_code,\n",
        "  status,\n",
        "  merchant_category,\n",
        "  payment_channel,\n",
        "  customer_segment,\n",
        "  card_type,\n",
        "  city,\n",
        "  CASE\n",
        "    WHEN is_international = true THEN 'International'\n",
        "    ELSE 'Domestic'\n",
        "  END as txn_type,\n",
        "  amount,\n",
        "  customer_id,\n",
        "  transaction_id\n",
        "FROM\n",
        "  fraud_kafka_project.gold.fraud_dectection"
      ]
    },
    {
      "name": "watchlist_sql",
      "displayName": "Watchlist Data",
      "queryLines": [
        "SELECT\n",
        "  risk_level,\n",
        "  reason_code,\n",
        "  reported_source\n",
        "FROM\n",
        "  fraud_kafka_project.bronze.stream_fraud_watchlist"
      ]
    },
    {
      "name": "sliding_sql",
      "displayName": "Sliding Window Data",
      "queryLines": [
        "SELECT\n",
        "  start as window_start,\n",
        "  `end` as window_end,\n",
        "  transactions_count\n",
        "FROM\n",
        "  fraud_kafka_project.gold.transactions_sliding_window"
      ]
    }
  ],
